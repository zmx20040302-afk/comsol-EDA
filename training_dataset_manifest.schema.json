{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "COMSOL Training Dataset Manifest",
  "type": "object",
  "required": ["kind", "schemaVersion", "dataset_csv", "role", "physical_scope", "inputs", "outputs", "provenance"],
  "properties": {
    "kind": {"const": "comsol-training-dataset-manifest"},
    "schemaVersion": {"const": "1.0.0"},
    "dataset_csv": {"type": "string", "minLength": 1},
    "role": {"enum": ["training", "holdout", "augmentation"]},
    "physical_scope": {"type": "string", "minLength": 1},
    "inputs": {"$ref": "#/$defs/columns"},
    "outputs": {"$ref": "#/$defs/columns"},
    "provenance": {
      "type": "object",
      "required": ["comsol_version", "model_reference", "study", "mesh_reference"],
      "properties": {
        "comsol_version": {"type": "string", "minLength": 1},
        "model_reference": {"type": "string", "minLength": 1},
        "study": {"type": "string", "minLength": 1},
        "mesh_reference": {"type": "string", "minLength": 1}
      }
    }
  },
  "$defs": {
    "columns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "unit"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "unit": {"type": "string", "minLength": 1},
          "description": {"type": "string"}
        }
      }
    }
  }
}
