{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dac2027-p4-human-author-approval.schema.json",
  "title": "DAC 2027 P4 Human Author Approval",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "schemaVersion", "approved", "approved_by", "approved_at",
    "manuscript_pdf_sha256", "p3_report_sha256", "checks"
  ],
  "properties": {
    "schema": {"const": "dac2027-p4-human-author-approval"},
    "schemaVersion": {"const": "1.0.0"},
    "approved": {"type": "boolean"},
    "approved_by": {"type": "string", "minLength": 1},
    "approved_at": {"type": "string", "format": "date-time"},
    "manuscript_pdf_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "p3_report_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claims_verified", "citations_verified", "double_blind_verified",
        "conflicts_verified", "ai_statement_verified", "authorship_verified"
      ],
      "properties": {
        "claims_verified": {"type": "boolean"},
        "citations_verified": {"type": "boolean"},
        "double_blind_verified": {"type": "boolean"},
        "conflicts_verified": {"type": "boolean"},
        "ai_statement_verified": {"type": "boolean"},
        "authorship_verified": {"type": "boolean"}
      }
    },
    "notes": {"type": "string"}
  }
}
