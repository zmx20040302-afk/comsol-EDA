{
  "schema": "comsol-temperature-experiment-validation-config",
  "schemaVersion": "1.0.0",
  "minimum_measured_samples": 5,
  "required_outputs": [
    "Tmax_K",
    "Tavg_K"
  ],
  "absolute_tolerance_K": {
    "Tmax_K": 5.0,
    "Tavg_K": 5.0
  },
  "require_comsol_values": true,
  "require_all_rows_in_validated_domain": true
}
